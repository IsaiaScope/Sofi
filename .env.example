# ============================================================================
# Sofi — local dev environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# For producing a distributable desktop binary, see `.env.production.example`.
# See `docs/oauth-setup.md` for provider setup walkthroughs.
# ============================================================================

# ---- Django backend --------------------------------------------------------

DEBUG=True
DJANGO_SECRET_KEY=django-insecure-dev-only-replace-in-prod
DATABASE_URL=postgres://sofi:sofi@localhost:5432/sofi

# ---- Email delivery (Resend) ----
# Leave RESEND_API_KEY empty to keep the console backend (prints emails to the
# Django runserver stdout — fine for offline dev). Paste an API key from
# https://resend.com/api-keys to send real emails via Resend SMTP.
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# Sender address shown in the From: header.
# - With the console backend: any string works (only appears in logs).
# - With Resend + unverified domain: must be `onboarding@resend.dev`.
# - With Resend + verified domain: use something like `no-reply@yourdomain.com`.
DEFAULT_FROM_EMAIL=Sofi <onboarding@resend.dev>

# Loopback-friendly dev origins (Tauri dev server + packaged Tauri scheme).
CORS_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost

# ---- OAuth — DEV apps ------------------------------------------------------
#
# Register ONE pair of OAuth apps per provider for dev; register a SEPARATE
# pair for prod (see `.env.production.example`). The dev apps can point to
# loopback redirect URIs and stay permissive; prod apps lock down their
# callback URL and publishing status.
#
# Google: create an OAuth client of type "Desktop app" on Google Cloud
# Console. Google accepts any http://127.0.0.1:<port> loopback for this
# client type — no redirect-URI registration required.
#
# GitHub: create an OAuth App on https://github.com/settings/developers.
# Set "Authorization callback URL" to `http://127.0.0.1` (no port). GitHub
# does loose port matching against loopback.
#
# Backend variables — the secret stays on the server, never shipped to
# the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#
# Frontend variables — baked into the Tauri bundle at build time by Vite.
# These MUST match the backend client IDs above. The secret values never
# leave the server, so there is no corresponding VITE_*_SECRET.
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
