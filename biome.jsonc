{
  "$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/src-tauri",
      "!**/dist",
      "!**/node_modules",
      "!**/.sofi-build",
      "!**/.claude",
      "!**/.superpowers",
      "!**/.worktrees",
      "!**/backend",
      "!**/tests",
      "!**/*.css",
      "!**/routeTree.gen.ts"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "warn",
        "useExhaustiveDependencies": "warn"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "a11y": {
        "noLabelWithoutControl": "off",
        "noStaticElementInteractions": "off",
        "noAutofocus": "off",
        "noSvgWithoutTitle": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "off"
      },
      "nursery": {
        // Sort className tokens into Tailwind's canonical order. Does NOT
        // rename deprecated classes (those come from the Tailwind VS Code
        // extension as IDE-only suggestions, or via `npx @tailwindcss/upgrade`).
        // Function list mirrors Ultracite's defaults so classes inside
        // cn()/clsx()/cva() are also sorted.
        "useSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": {
            "attributes": ["className"],
            "functions": ["cn", "clsx", "cva", "tw", "twMerge", "twJoin", "tv"]
          }
        }
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
