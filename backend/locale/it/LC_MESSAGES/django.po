#: apps/users/serializers.py:38
msgid "A user is already registered with this e-mail address."
msgstr "Un utente è già registrato con questo indirizzo email."

#: apps/users/templates/account/email/email_confirmation_message.html:8
#: apps/users/templates/account/email/email_confirmation_subject.txt:1
msgid "Confirm your Sofi email"
msgstr "Conferma la tua email Sofi"

#: apps/users/templates/account/email/email_confirmation_message.html:13
msgid "Confirm your operator profile to activate Sofi."
msgstr "Conferma il tuo profilo operatore per attivare Sofi."

#: apps/users/templates/account/email/email_confirmation_message.html:24
msgid "Secure Dispatch"
msgstr "Dispaccio Sicuro"

#: apps/users/templates/account/email/email_confirmation_message.html:36
msgid "incoming transmission"
msgstr "trasmissione in arrivo"

#: apps/users/templates/account/email/email_confirmation_message.html:39
#, python-format
msgid "Welcome aboard, %(user_display)s."
msgstr "Benvenuto a bordo, %(user_display)s."

#: apps/users/templates/account/email/email_confirmation_message.html:48
msgid "Verify your email"
msgstr "Verifica la tua email"

#: apps/users/templates/account/email/email_confirmation_message.html:57
msgid ""
"Thanks for signing up for Sofi — your AI agent command center. Confirm your "
"email below to activate your operator profile."
msgstr ""
"Grazie per esserti registrato a Sofi — il tuo centro di comando per agenti "
"IA. Conferma la tua email qui sotto per attivare il tuo profilo operatore."

#: apps/users/templates/account/email/email_confirmation_message.html:69
msgid "Confirm Email"
msgstr "Conferma Email"

#: apps/users/templates/account/email/email_confirmation_message.html:81
#: apps/users/templates/account/email/password_reset_key_message.html:81
msgid "Or copy this link:"
msgstr "Oppure copia questo link:"

#: apps/users/templates/account/email/email_confirmation_message.html:98
msgid "If you didn't sign up for Sofi, you can safely ignore this message."
msgstr ""
"Se non ti sei registrato a Sofi, puoi tranquillamente ignorare questo "
"messaggio."

#: apps/users/templates/account/email/email_confirmation_message.html:101
#: apps/users/templates/account/email/password_reset_key_message.html:101
msgid "The Sofi team"
msgstr "Il team di Sofi"

#: apps/users/templates/account/email/email_confirmation_message.txt:1
#, python-format
msgid ""
"> INCOMING TRANSMISSION\n"
"\n"
"Welcome aboard, %(user_display)s.\n"
"\n"
"Thanks for signing up for Sofi — your AI agent command center. Confirm your "
"email below to activate your operator profile.\n"
"\n"
"  %(activate_url)s\n"
"\n"
"If you didn't sign up for Sofi, you can safely ignore this message.\n"
"\n"
"// The Sofi team\n"
msgstr ""
"> TRASMISSIONE IN ARRIVO\n"
"\n"
"Benvenuto a bordo, %(user_display)s.\n"
"\n"
"Grazie per esserti registrato a Sofi — il tuo centro di comando per agenti "
"IA. Conferma la tua email qui sotto per attivare il tuo profilo operatore.\n"
"\n"
"  %(activate_url)s\n"
"\n"
"Se non ti sei registrato a Sofi, puoi tranquillamente ignorare questo "
"messaggio.\n"
"\n"
"// Il team di Sofi\n"

#: apps/users/templates/account/email/password_reset_key_message.html:8
#: apps/users/templates/account/email/password_reset_key_subject.txt:1
msgid "Reset your Sofi access key"
msgstr "Reimposta la tua chiave di accesso Sofi"

#: apps/users/templates/account/email/password_reset_key_message.html:13
msgid "A password reset was requested for your operator profile."
msgstr "È stata richiesta una reimpostazione per il tuo profilo operatore."

#: apps/users/templates/account/email/password_reset_key_message.html:24
msgid "Credential Reset"
msgstr "Reset Credenziali"

#: apps/users/templates/account/email/password_reset_key_message.html:36
msgid "reset link dispatched"
msgstr "link di reset inviato"

#: apps/users/templates/account/email/password_reset_key_message.html:39
msgid ""
"Someone — hopefully you — requested a password reset for this operator "
"profile."
msgstr ""
"Qualcuno — speriamo tu — ha richiesto una reimpostazione della password per "
"questo profilo operatore."

#: apps/users/templates/account/email/password_reset_key_message.html:48
msgid "Reset access"
msgstr "Reimposta accesso"

#: apps/users/templates/account/email/password_reset_key_message.html:57
msgid ""
"Open the link below in Sofi to set a new access key. If you didn't request "
"this, ignore this message — your existing key stays valid."
msgstr ""
"Apri il link qui sotto in Sofi per impostare una nuova chiave di accesso. Se "
"non hai richiesto questa operazione, ignora questo messaggio — la tua chiave "
"attuale rimane valida."

#: apps/users/templates/account/email/password_reset_key_message.html:69
msgid "Set new access key"
msgstr "Imposta nuova chiave"

#: apps/users/templates/account/email/password_reset_key_message.html:98
msgid ""
"This link expires shortly. If you didn't request a reset, no action is "
"needed."
msgstr ""
"Questo link scade a breve. Se non hai richiesto una reimpostazione, non è "
"necessaria alcuna azione."

#: apps/users/templates/account/email/password_reset_key_message.txt:1
msgid ""
"A password reset was requested for your Sofi operator profile. Open the link "
"below in Sofi to set a new access key:"
msgstr ""
"È stata richiesta una reimpostazione della password per il tuo profilo "
"operatore Sofi. Apri il link qui sotto in Sofi per impostare una nuova "
"chiave di accesso:"

#: apps/users/templates/account/email/password_reset_key_message.txt:8
msgid ""
"This link expires shortly. If you didn't request a reset, ignore this "
"message — your existing key stays valid. — The Sofi team"
msgstr ""
"Questo link scade a breve. Se non hai richiesto una reimpostazione, ignora "
"questo messaggio — la tua chiave attuale rimane valida. — Il team di Sofi"

#: apps/users/templates/users/email_verified.html:7
