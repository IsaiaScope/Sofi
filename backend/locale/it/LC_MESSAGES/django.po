#: apps/users/templates/users/email_verified.html:315
msgid "Email verified. Proceed to command center."
msgstr "Email verificata. Procedi al centro di comando."

#: apps/users/templates/users/email_verified.html:318
msgid "Return to Sofi"
msgstr "Torna su Sofi"

#: apps/users/templates/users/email_verified.html:320
#: apps/users/templates/users/password_reset_landing.html:312
msgid ""
"If nothing happens, make sure the Sofi desktop app is installed, then open "
"it manually and sign in."
msgstr ""
"Se non succede nulla, assicurati che l'app desktop Sofi sia installata, poi "
"aprila manualmente e accedi."

